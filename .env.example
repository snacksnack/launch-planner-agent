# launch-planner-agent configuration. Copy to `.env` and fill in as needed.
# All variables are prefixed LPA_.

LPA_APP_NAME=launch-planner-agent
LPA_ENVIRONMENT=development

# Plan-of-record snapshot store (P1.8+).
LPA_DATABASE_URL=sqlite:///./launch_planner.db

# LLM layer (the `agents` package). Optional — the API boots without it.
LPA_ANTHROPIC_API_KEY=
LPA_ANTHROPIC_MODEL=claude-sonnet-5

# Which plan the Gantt UI schedules and renders. Defaults to the flagship
# golden; the deployed demo points at the SKY-keyed copy beside it (RC1-213).
LPA_PLAN_PATH=fixtures/jira-cloud-migration/golden/expected-plan.json

# Backups of the plan of record (RC1-246). All optional. With no bucket set,
# `plan backup` writes to a local directory — fine locally, NOT a backup in
# production, since it dies with the volume the database is on. S3 support needs
# the extra: `uv sync --all-packages --extra s3`.
LPA_BACKUP_DIR=./backups
LPA_BACKUP_KEEP=14
LPA_BACKUP_S3_BUCKET=
LPA_BACKUP_S3_PREFIX=plan-store/
LPA_BACKUP_S3_ENDPOINT_URL=

# Jira. The base URL alone is enough to turn `jira_key`s into clickable browse
# links; email + token are only needed for the gated `--real` push (P3.1).
LPA_JIRA_BASE_URL=
LPA_JIRA_EMAIL=
LPA_JIRA_API_TOKEN=
